---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign documents = site.articles | concat: site.sections | concat: site.authors %}
{% for item in documents %}{% unless item.sitemap == false %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endunless %}{% endfor %}
{% for item in site.pages %}{% if item.title and item.url != '/404.html' %}{% unless item.sitemap == false %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endunless %}{% endif %}{% endfor %}
</urlset>